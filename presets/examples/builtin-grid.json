{
  "format": "artboard-forge.presets",
  "version": 1,
  "kind": "grid",
  "presets": [
    {
      "id": "campaign-grid",
      "name": "Campaign Grid",
      "notes": "6 × 8 modular grid, 24 pt gutters, 72 pt margins, centre axes. Tuned for 1080-wide social posts.",
      "spec": {
        "margins": {
          "top": 72,
          "right": 72,
          "bottom": 72,
          "left": 72
        },
        "columns": {
          "count": 6,
          "gutter": 24
        },
        "rows": {
          "count": 8,
          "gutter": 24
        },
        "center": true,
        "marginGuides": true,
        "spanArea": true
      }
    },
    {
      "id": "twelve-column",
      "name": "12 Columns",
      "spec": {
        "margins": {
          "top": 64,
          "right": 64,
          "bottom": 64,
          "left": 64
        },
        "columns": {
          "count": 12,
          "gutter": 24
        },
        "marginGuides": true,
        "spanArea": true
      }
    },
    {
      "id": "poster",
